[Unit]
Description=barux Touch Bar daemon

# Never alongside tiny-dfr: starting one stops the other (both want DRM master on
# the bar and an exclusive grab on the digitizer). The ordering makes tiny-dfr's
# stop finish before we start. tiny-dfr is also pulled in by its own udev rule
# (SYSTEMD_WANTS), so it must be masked as well; see docs/GUIA.md.
Conflicts=tiny-dfr.service
After=tiny-dfr.service

# Nor alongside touchbinux, this daemon's old name (an install migrated from it may
# still have its unit; see tools/migrate-from-touchbinux.sh). Conflicts= works both
# ways: starting either one stops the other.
Conflicts=touchbinux.service
After=touchbinux.service

# Same ordering as tiny-dfr: after logind and after plymouth has let go of DRM.
After=systemd-logind.service systemd-user-sessions.service plymouth-quit.service

# Display and digitizer, named by 99-zz-barux.rules. Started when the digitizer
# appears (see [Install]), stopped if either goes away.
BindsTo=dev-barux_display.device dev-barux_touch.device
After=dev-barux_display.device dev-barux_touch.device

# Restart=on-failure, but give up after 5 failures in 60 s instead of looping.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/barux bar --config /etc/barux/config.toml
# SIGHUP re-reads the config (and redraws); a broken config keeps the old one.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# SIGTERM to the daemon only: it blanks the bar, removes /run/barux.sock,
# destroys the virtual keyboard and kills its own children. Whatever is left after
# that (or after TimeoutStopSec) gets SIGKILL.
KillMode=mixed
TimeoutStopSec=5

# --- Hardening ------------------------------------------------------------------
# Everything here also applies to the commands the daemon starts for buttons: they
# run as run_as, but as its children, inside this service's sandbox (the kitty
# windows of the bar's launcher too, and whatever runs in them). So only options
# that ordinary interactive use doesn't notice are enabled, and even those take a
# little away from it (see docs/SECURITY.md, which also has what the daemon alone
# needs). Check with: systemd-analyze security barux.service

# /usr, /boot, /efi and /etc read-only. The daemon only reads /etc/barux (and
# whatever icon paths the config names). /run (socket), /dev and /sys (backlight)
# stay writable. Commands notice it: `sudo pacman -Syu` in a terminal opened from
# the bar fails with "read-only file system" (use any other terminal).
ProtectSystem=full
# /var/lib/barux, created by systemd (root, 0755) and passed in
# $STATE_DIRECTORY: choices made on the bar (a gif_picker's GIF) in state.toml.
# The config in /etc is never written.
StateDirectory=barux
# /proc/sys and similar read-only. On this systemd (262) /sys itself stays writable:
# tiny-dfr runs with the same option and writes its backlight in /sys/class/backlight.
ProtectKernelTunables=true
# No module loading (uinput is loaded at boot by modules-load.d/barux.conf).
ProtectKernelModules=true
# No access to the kernel log (/dev/kmsg, /proc/kmsg).
ProtectKernelLogs=true
# cgroupfs read-only.
ProtectControlGroups=true
# Can't create setuid/setgid files.
RestrictSUIDSGID=true
# Only arm64 system calls. The M2 can't run 32-bit code and this kernel has no
# CONFIG_COMPAT, so there are no others to call: this only closes the door.
SystemCallArchitectures=native
# No realtime scheduling of its own. The user's processes can't take it anyway
# (RLIMIT_RTPRIO 0); audio apps get it from rtkit, another process, unaffected.
RestrictRealtime=true

# Considered and left out, because the daemon or button commands need what they take
# away (tested or reasoned in docs/SECURITY.md):
# NoNewPrivileges=true      # sudo, pkexec, fusermount3... fail in those terminals.
# ProtectSystem=strict      # makes /home read-only for commands too.
# ProtectHome=true          # /home and /run/user hidden: no Hyprland sockets, no
#                           # icons from ~/.local/share/icons, commands lose $HOME.
#                           # (read-only: the daemon would cope; commands couldn't
#                           # write a file in $HOME.)
# PrivateTmp=true           # no /tmp/mpv-socket (the player); commands would get a
#                           # private /tmp, invisible to the session.
# CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL CAP_SETUID CAP_SETGID
#                           # what the daemon itself needs, but the bounding set
#                           # limits sudo in those terminals as well.
# DevicePolicy=closed + DeviceAllow=char-drm rw, char-input rw, /dev/uinput rw
#                           # enough for the daemon; kitty also needs its GPU and
#                           # ptys, and a terminal may need any device (fuse, kvm,
#                           # video, snd, block devices for sudo...).
# PrivateDevices=true       # hides /dev/dri, /dev/input and /dev/uinput.
# ProtectClock=true         # also adds DeviceAllow=char-rtc, i.e. an allow-list
#                           # with nothing else on it.
# RestrictAddressFamilies=AF_UNIX AF_NETLINK   # commands couldn't use the network.
# RestrictNamespaces=true   # breaks bwrap/flatpak and browsers' sandboxes.
# SystemCallFilter=@system-service             # inherited by every command.
# MemoryDenyWriteExecute=true                  # breaks JITs (browsers, node...).
# LockPersonality=true      # gdb can't turn ASLR off; x86 emulation may need it.
# ProtectProc=invisible / ProcSubset=pid       # htop from the bar would see only
#                           # its user's processes, or no /proc/meminfo.
# UMask=0077                # inherited: files made in those terminals 0600.
# ProtectHostname=true      # commands would not see later hostname changes.
# PrivateIPC=true           # Xwayland apps started from a button lose MIT-SHM.

[Install]
# Started whenever the Touch Bar digitizer shows up (boot, or a driver rebind),
# but only while enabled: `systemctl disable` removes this link.
WantedBy=dev-barux_touch.device
